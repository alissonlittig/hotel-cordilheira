<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hotel Cordilheira · Banda fictícia de dream-pop (demo)</title>
<meta name="description" content="{{ site.desc }}">
<meta name="theme-color" content="#0f0c0b">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230f0c0b'/%3E%3Cpath d='M3 25l8-11 5 6 5-9 8 14z' fill='%23ff8a4c'/%3E%3C/svg%3E">
<link rel="preload" href="{{ '/assets/bricolage.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
<div class="demo-bar">Site de demonstração de portfólio. Banda, datas, discos e preços são fictícios.</div>
<header class="top"><div class="wrap bar-in">
  <a class="logo" href="#topo" aria-label="Hotel Cordilheira, início"><svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path d="M2 26l9-12 5 6 5-10 9 16z" fill="currentColor"/></svg><span>Hotel Cordilheira</span></a>
  <nav aria-label="Principal"><a href="#shows">Shows</a><a href="#discos">Discos</a><a href="#loja">Loja</a><a href="#banda">Banda</a></nav>
  <button class="cart-btn" id="cart-open" type="button" aria-label="Abrir sacola">Sacola <span id="cart-n">0</span></button>
</div></header>
<main>
{{ content | safe }}
</main>
<footer class="foot"><div class="wrap">
  <p><strong>Hotel Cordilheira</strong> · banda fictícia criada para demonstração. Nenhum ingresso, disco ou produto é real.</p>
  <p class="mono">Feito com Eleventy · código aberto no GitHub</p>
</div></footer>
<script>window.__DATA__={{ { shows: shows, releases: releases, merch: merch } | json | safe }};</script>
<script type="module" src="{{ '/assets/app.js' | url }}"></script>
</body>
</html>
